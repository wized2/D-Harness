<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="12dp"
            android:src="@drawable/ic_close_m3"
            android:tint="@color/on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:textColor="@color/on_surface_var"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <!-- Keys -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="Keys" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GitHub PAT"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/patInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ghp_…"
                    android:inputType="textPassword"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/patHelper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="Stored as key github"
                    android:textColor="@color/on_surface_var"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSavePat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Save as key github" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/outline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Other secrets"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/keyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Key name"
                    android:inputType="text"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/keyValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Key value"
                    android:inputType="textPassword" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSaveKey"
                        style="@style/Widget.DHarness.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Save key" />

                    <Button
                        android:id="@+id/btnDeleteKey"
                        style="@style/Widget.DHarness.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Delete key" />
                </LinearLayout>

                <TextView
                    android:id="@+id/keysList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/on_surface_var"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Options -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="Options" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="20dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDesktop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="Desktop site"
                    android:textColor="@color/on_surface" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchInject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="Auto-inject tools"
                    android:textColor="@color/on_surface" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDedupe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="Dedupe tool calls"
                    android:textColor="@color/on_surface" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="Claude theme"
                    android:textColor="@color/on_surface" />
            </LinearLayout>

            <!-- Agent -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="Agent" />

            <Button
                android:id="@+id/btnSendInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Send tool instructions to chat" />

            <!-- Maintenance -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="Maintenance" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnReload"
                    style="@style/Widget.DHarness.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reload chat" />

                <Space android:layout_width="match_parent" android:layout_height="10dp" />

                <Button
                    android:id="@+id/btnReinject"
                    style="@style/Widget.DHarness.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Re-inject shim" />

                <Space android:layout_width="match_parent" android:layout_height="10dp" />

                <Button
                    android:id="@+id/btnClearCache"
                    style="@style/Widget.DHarness.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear WebView cache" />

                <Space android:layout_width="match_parent" android:layout_height="10dp" />

                <Button
                    android:id="@+id/btnClearMemory"
                    style="@style/Widget.DHarness.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear agent memory" />

                <Space android:layout_width="match_parent" android:layout_height="10dp" />

                <Button
                    android:id="@+id/btnClearFs"
                    style="@style/Widget.DHarness.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear native FS" />
            </LinearLayout>

            <TextView
                android:id="@+id/toolsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/on_surface_var"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Done" />
</LinearLayout>
