<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#12161C">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="D-Harness"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#668899"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="GitHub PAT" android:textColor="#4D6BFE" android:textStyle="bold"
                android:paddingBottom="6dp" />
            <EditText android:id="@+id/patInput" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="ghp_…"
                android:inputType="textPassword" android:textColor="#FFFFFF"
                android:textColorHint="#556677" android:backgroundTint="#4D6BFE" />
            <Button android:id="@+id/btnSavePat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Save PAT as key github" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Other keys" android:textColor="#4D6BFE" android:textStyle="bold"
                android:paddingTop="16dp" android:paddingBottom="6dp" />
            <EditText android:id="@+id/keyName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="name" android:inputType="text"
                android:textColor="#FFFFFF" android:textColorHint="#556677" />
            <EditText android:id="@+id/keyValue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="value" android:inputType="textPassword"
                android:textColor="#FFFFFF" android:textColorHint="#556677" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnSaveKey" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Save" />
                <Button android:id="@+id/btnDeleteKey" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Delete" />
            </LinearLayout>
            <TextView android:id="@+id/keysList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#8899AA" android:textSize="12sp"
                android:fontFamily="monospace" android:paddingTop="4dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Options" android:textColor="#4D6BFE" android:textStyle="bold"
                android:paddingTop="16dp" android:paddingBottom="6dp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchDesktop"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Desktop site" android:textColor="#DDE3EA" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchInject"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Auto-inject tools" android:checked="true" android:textColor="#DDE3EA" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchDedupe"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Dedupe tool calls" android:checked="true" android:textColor="#DDE3EA" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Agent" android:textColor="#4D6BFE" android:textStyle="bold"
                android:paddingTop="16dp" android:paddingBottom="6dp" />
            <Button android:id="@+id/btnSendInstructions" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send tool instructions to chat"
                android:backgroundTint="#4D6BFE" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Maintenance" android:textColor="#4D6BFE" android:textStyle="bold"
                android:paddingTop="16dp" android:paddingBottom="6dp" />
            <Button android:id="@+id/btnReload" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Reload chat" />
            <Button android:id="@+id/btnReinject" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Re-inject shim" />
            <Button android:id="@+id/btnClearCache" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Clear WebView cache" />
            <Button android:id="@+id/btnClearMemory" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Clear agent memory" />
            <Button android:id="@+id/btnClearFs" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Clear native FS" />

            <TextView android:id="@+id/toolsList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#778899" android:textSize="11sp"
                android:fontFamily="monospace" android:paddingTop="16dp" android:paddingBottom="24dp" />
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnClose" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Done"
        android:layout_margin="12dp" />
</LinearLayout>
