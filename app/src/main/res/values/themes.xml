<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat only — no Material dependency (APK size) -->
    <style name="Theme.DHarness" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/surface</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_var</item>
        <item name="editTextStyle">@style/Widget.DHarness.EditText</item>
        <item name="buttonStyle">@style/Widget.DHarness.Button</item>
        <item name="switchStyle">@style/Widget.DHarness.Switch</item>
    </style>

    <style name="Widget.DHarness.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/on_surface_var</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.DHarness.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#001A41</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.DHarness.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.DHarness.Button.Ghost" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.DHarness.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Section" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/tertiary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
